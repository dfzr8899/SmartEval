# Required for Compose. Generate two independent secrets of at least 32 bytes.
SMARTEVAL_DATABASE_PASSWORD=
SMARTEVAL_SESSION_SECRET=
SMARTEVAL_INTERNAL_TOKEN=

# Initial teacher/admin. Password must be at least 12 characters. Clear after setup.
SMARTEVAL_BOOTSTRAP_USER=
SMARTEVAL_BOOTSTRAP_PASSWORD=

# Compose binds Web to loopback. Set the matching public origin when changing the port.
SMARTEVAL_WEB_PORT=8088
SMARTEVAL_PUBLIC_ORIGIN=http://localhost:8088
SMARTEVAL_SECURE_COOKIES=false
# Optional Cloudflare Tunnel token (enable with: docker compose --profile cloudflare up -d).
# In Cloudflare Zero Trust Public Hostname, point HTTP service to: http://web:80
CLOUDFLARED_TOKEN=
SMARTEVAL_WORKER_ENABLED=true
# Combined preparation and grading concurrency per Business process (1–128).
SMARTEVAL_WORKER_CONCURRENCY=8
SMARTEVAL_ASSET_RETENTION_HOURS=24
SMARTEVAL_SIMILARITY_THRESHOLD=0.60
# Enable only for local webhook tests. Private and link-local addresses stay blocked.
SMARTEVAL_WEBHOOK_ALLOW_LOOPBACK=false

# Default text model. Complete one provider's settings below.
SMARTEVAL_MODEL_BASE_URL=https://api.deepseek.com
SMARTEVAL_MODEL_NAME=deepseek-flash
SMARTEVAL_MODEL_API_KEY=
# text omits response_format. Choose json_object or json_schema if the endpoint supports it.
SMARTEVAL_MODEL_RESPONSE_FORMAT=json_object
SMARTEVAL_MODEL_TOKEN_LIMIT_FIELD=max_tokens
SMARTEVAL_MODEL_EXTRA_BODY_JSON=

# DeepSeek: BASE_URL=https://api.deepseek.com, NAME=deepseek-flash, API_KEY=<your key>
# Use RESPONSE_FORMAT=json_object. Where supported, set EXTRA_BODY_JSON='{"thinking":{"type":"disabled"}}'.
# OpenAI: BASE_URL=https://api.openai.com/v1, NAME=gpt-4o-mini, API_KEY=<your key>
# Use RESPONSE_FORMAT=json_schema and TOKEN_LIMIT_FIELD=max_completion_tokens for compatible models.
# Ollama on the host: BASE_URL=http://host.docker.internal:11434/v1, NAME=<installed tag>, API_KEY=ollama
# Native Ollama uses http://127.0.0.1:11434/v1. On Linux use an address reachable from the container.
# Qwen and vLLM: set the deployment's OpenAI-compatible base URL, served model name and credential.

# Optional per-role overrides. Empty MODEL inherits the default name. A different
# BASE_URL requires its own API_KEY (use a placeholder only for a trusted keyless endpoint).
# Set provider-specific response format, token field and extra body on a different endpoint.
SMARTEVAL_QUESTION_READER_MODEL=
SMARTEVAL_QUESTION_READER_BASE_URL=
SMARTEVAL_QUESTION_READER_API_KEY=
SMARTEVAL_QUESTION_READER_RESPONSE_FORMAT=
SMARTEVAL_QUESTION_READER_TOKEN_LIMIT_FIELD=
SMARTEVAL_QUESTION_READER_EXTRA_BODY_JSON=

SMARTEVAL_RUBRIC_DESIGNER_MODEL=
SMARTEVAL_RUBRIC_DESIGNER_BASE_URL=
SMARTEVAL_RUBRIC_DESIGNER_API_KEY=
SMARTEVAL_RUBRIC_DESIGNER_RESPONSE_FORMAT=
SMARTEVAL_RUBRIC_DESIGNER_TOKEN_LIMIT_FIELD=
SMARTEVAL_RUBRIC_DESIGNER_EXTRA_BODY_JSON=

SMARTEVAL_GRADER_MODEL=
SMARTEVAL_GRADER_BASE_URL=
SMARTEVAL_GRADER_API_KEY=
SMARTEVAL_GRADER_RESPONSE_FORMAT=
SMARTEVAL_GRADER_TOKEN_LIMIT_FIELD=
SMARTEVAL_GRADER_EXTRA_BODY_JSON=

SMARTEVAL_EVIDENCE_REVIEWER_MODEL=
SMARTEVAL_EVIDENCE_REVIEWER_BASE_URL=
SMARTEVAL_EVIDENCE_REVIEWER_API_KEY=
SMARTEVAL_EVIDENCE_REVIEWER_RESPONSE_FORMAT=
SMARTEVAL_EVIDENCE_REVIEWER_TOKEN_LIMIT_FIELD=
SMARTEVAL_EVIDENCE_REVIEWER_EXTRA_BODY_JSON=
# EvidenceReviewer protocol: revise (default, two-stage rubric+evidence revision) or veto (binary approval only).
SMARTEVAL_REVIEW_MODE=revise

SMARTEVAL_LOGIC_REVIEWER_MODEL=
SMARTEVAL_LOGIC_REVIEWER_BASE_URL=
SMARTEVAL_LOGIC_REVIEWER_API_KEY=
SMARTEVAL_LOGIC_REVIEWER_RESPONSE_FORMAT=
SMARTEVAL_LOGIC_REVIEWER_TOKEN_LIMIT_FIELD=
SMARTEVAL_LOGIC_REVIEWER_EXTRA_BODY_JSON=

# Optional multimodal endpoint. Leave URL empty to reuse the default endpoint and credential.
SMARTEVAL_VISION_MODEL=
SMARTEVAL_VISION_BASE_URL=
SMARTEVAL_VISION_API_KEY=
SMARTEVAL_VISION_TOKEN_LIMIT_FIELD=
SMARTEVAL_VISION_EXTRA_BODY_JSON=
# Installed Tesseract language packs. The container includes Chinese (simplified) and English.
SMARTEVAL_OCR_LANGUAGES=chi_sim+eng

# Optional external Judge0 CE. Use a private address reachable from Business,
# e.g. http://host.docker.internal:2358 on Docker Desktop, or your deployment's HTTPS URL.
# The instance must support asynchronous submissions. Set the token for X-Auth-Token if required.
# Copy IDs from that instance's GET /languages, e.g. PYTHON=71,CPP=54; these IDs can vary.
SMARTEVAL_JUDGE_URL=
SMARTEVAL_JUDGE_TOKEN=
SMARTEVAL_JUDGE_LANGUAGES=
SMARTEVAL_JUDGE_MEMORY_KIB=262144
SMARTEVAL_JUDGE_CPU_TIME_MS=3000
SMARTEVAL_JUDGE_WALL_TIME_MS=5000
SMARTEVAL_JUDGE_POLL_SECONDS=25

# Optional SMTP for recovery address verification and password resets.
SMARTEVAL_SMTP_HOST=
SMARTEVAL_SMTP_FROM=
SMARTEVAL_SMTP_PORT=587
SMARTEVAL_SMTP_USER=
SMARTEVAL_SMTP_PASSWORD=
SMARTEVAL_SMTP_AUTH=true
SMARTEVAL_SMTP_STARTTLS=true

# Default is the shared /objects volume. An S3 endpoint switches both services to S3.
# Create the bucket first; grant the service GetObject, PutObject and DeleteObject
# for managed objects and the health/ prefix used by Intelligence readiness probes.
SMARTEVAL_S3_ENDPOINT=
SMARTEVAL_S3_BUCKET=
SMARTEVAL_S3_REGION=us-east-1
SMARTEVAL_S3_ACCESS_KEY=
SMARTEVAL_S3_SECRET_KEY=
